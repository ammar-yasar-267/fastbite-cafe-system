# Copy to .env (or just run scripts/init-env.sh, which does it for you with random passwords).
# .env is git-ignored. Never commit real values.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=fastbite
MONGO_APP_PASSWORD=

# Optional: which published images to use (see README, "Run the published images").
# DOCKERHUB_USERNAME=your-dockerhub-name
# IMAGE_TAG=latest
